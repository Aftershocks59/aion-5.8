# Ignore Gradle build outputs and caches.
build/
.gradle/

# Ignore legacy Ant build outputs.
bin/
*.class

# Ignore runtime artefacts produced by the servers.
#
# Name the log directories rather than matching "log/" anywhere: that pattern
# also matched a source package called log and silently kept it out of a commit,
# leaving the build referring to a class the repository did not hold.
AL-Game/cache/
AL-Login/cache/
AL-Chat/log/
AL-Game/log/
AL-Login/log/
*.log

# Ignore JVM crash and heap dumps.
*.hprof
hs_err_pid*.log
replay_pid*.log

# Reference material placed under import/ is never committed. It is read to
# reproduce behaviour faithfully in the tracked sources; nothing in it is
# published.
import/
# Ignore geodata, which is distributed separately (see README).
Geodata/
AL-Game/data/geo/
*.geo

# Ignore IDE files: they are developer-specific and Gradle regenerates them.
.idea/
*.iml
.classpath
.project
.settings/
out/
nbactions.xml

# Ignore OS noise.
Thumbs.db
.DS_Store

# Exclude AI assistant artefacts from the repository.
.claude/
CLAUDE.md
.cursor/
.aider*
.github/copilot-instructions.md
