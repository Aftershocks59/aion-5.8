# Ignore Gradle build outputs and caches.
build/
.gradle/

# Ignore legacy Ant build outputs.
bin/
*.class

# Ignore runtime artefacts produced by the servers.
AL-Game/cache/
log/
*.log

# Ignore JVM crash and heap dumps.
*.hprof
hs_err_pid*.log
replay_pid*.log

# Ignore geodata, which is distributed separately (see README).
Geodata/
AL-Game/data/geo/
*.geo

# Ignore IDE files: they are developer-specific and Gradle regenerates them.
.idea/
*.iml
.classpath
.project
.settings/
out/
nbactions.xml

# Ignore OS noise.
Thumbs.db
.DS_Store

# Exclude AI assistant artefacts from the repository.
.claude/
CLAUDE.md
.cursor/
.aider*
.github/copilot-instructions.md
